{
  "name": "explorer-manager",
  "repository": {
    "type": "git",
    "url": "https://github.com/UrosVuj/Explorer-Bookmark.git"
  },
  "publisher": "UrosVujosevic",
  "displayName": "Explorer Bookmark",
  "description": "Quickly access important folders and files",
  "icon": "docs/icon.png",
  "version": "1.0.1",
  "engines": {
    "vscode": "^1.55.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "explorer",
    "folder",
    "bookmark",
    "file",
    "focus",
    "manager",
    "finder",
    "drawer"
  ],
  "activationEvents": [
    "onView:explorer-bookmark",
    "onCommand:directoryprovider/selectitem",
    "onCommand:directoryprovider/removeitem",
    "onCommand:directoryprovider/removeallitems"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsWelcome": [
      {
        "view": "explorer-bookmark",
        "contents": "Right click and add a file or folder"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "explorer-bookmark",
          "name": "Explorer Bookmark"
        }
      ]
    },
    "commands": [
      {
        "command": "directoryprovider/refreshentry",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "directoryprovider/selectitem",
        "title": "Add to Explorer Bookmark"
      },
      {
        "command": "directoryprovider/openitem",
        "title": "Open"
      },
      {
        "command": "directoryprovider/openitemtoside",
        "title": "Open to the Side"
      },
      {
        "command": "directoryprovider/revealinexplorer",
        "title": "Reveal in Explorer View"
      },
      {
        "command": "directoryprovider/copypath",
        "title": "Copy Path"
      },
      {
        "command": "directoryprovider/copyrelativepath",
        "title": "Copy Relative Path"
      },
      {
        "command": "directoryprovider/renameresource",
        "title": "Rename..."
      },
      {
        "command": "directoryprovider/deleteresource",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "directoryprovider/newfile",
        "title": "New File..."
      },
      {
        "command": "directoryprovider/newfolder",
        "title": "New Folder..."
      },
      {
        "command": "directoryprovider/removeitem",
        "title": "Remove from Explorer Bookmark",
        "icon": "$(close)"
      },
      {
        "command": "directoryprovider/removeallitems",
        "title": "Remove All Items",
        "icon": "$(trash)"
      },
      {
        "command": "directoryprovider/cantremoveitem",
        "title": "Remove from Explorer Bookmark"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "directoryprovider/refreshentry",
          "when": "view == explorer-bookmark",
          "group": "navigation"
        },
        {
          "command": "directoryprovider/removeallitems",
          "when": "view == explorer-bookmark",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "directoryprovider/selectitem"
        }
      ],
      "view/item/context": [
        {
          "command": "directoryprovider/openitem",
          "when": "view == explorer-bookmark && (viewItem == directlyBookmarkedFile || viewItem == bookmarkedChildFile)",
          "group": "0_open"
        },
        {
          "command": "directoryprovider/openitemtoside",
          "when": "view == explorer-bookmark && (viewItem == directlyBookmarkedFile || viewItem == bookmarkedChildFile)",
          "group": "0_open"
        },
        {
          "command": "directoryprovider/newfile",
          "when": "view == explorer-bookmark && (viewItem == directlyBookmarkedFolder || viewItem == bookmarkedChildFolder)",
          "group": "0_open"
        },
        {
          "command": "directoryprovider/newfolder",
          "when": "view == explorer-bookmark && (viewItem == directlyBookmarkedFolder || viewItem == bookmarkedChildFolder)",
          "group": "0_open"
        },
        {
          "command": "directoryprovider/revealinexplorer",
          "when": "view == explorer-bookmark",
          "group": "1_reveal"
        },
        {
          "command": "directoryprovider/copypath",
          "when": "view == explorer-bookmark",
          "group": "2_copy"
        },
        {
          "command": "directoryprovider/copyrelativepath",
          "when": "view == explorer-bookmark",
          "group": "2_copy"
        },
        {
          "command": "directoryprovider/renameresource",
          "when": "view == explorer-bookmark",
          "group": "3_modify"
        },
        {
          "command": "directoryprovider/deleteresource",
          "when": "view == explorer-bookmark",
          "group": "3_modify"
        },
        {
          "command": "directoryprovider/removeitem",
          "when": "view == explorer-bookmark && (viewItem == directlyBookmarkedFile || viewItem == directlyBookmarkedFolder)",
          "group": "4_bookmark"
        },
        {
          "command": "directoryprovider/removeitem",
          "when": "view == explorer-bookmark && (viewItem == directlyBookmarkedFile || viewItem == directlyBookmarkedFolder)",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Explorer Bookmark",
      "properties": {
        "explorer-bookmark.saveWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "Save the current explorer view when closing VS Code"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "npm run test:unit",
    "test:unit": "mocha --ui tdd ./out/test/node/**/*.test.js",
    "test:integration": "node ./out/test/runTest.js",
    "test:integration:local": "node ./out/test/runTest.js --use-local-vscode",
    "verify": "npm run compile && npm run lint && npm run test:unit",
    "verify:integration": "npm run verify && npm run test:integration",
    "package:extension": "vsce package",
    "publish:extension": "vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.1",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.39.4",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  }
}
